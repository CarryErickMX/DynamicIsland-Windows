<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>

    <!-- Ícono del .exe (Explorador, menú Inicio, Administrador de tareas) -->
    <ApplicationIcon>Assets\DynamicIsland.ico</ApplicationIcon>

    <!-- Metadatos visibles en Propiedades del .exe -->
    <Product>Dynamic Island para Windows</Product>
    <Description>Isla dinámica estilo iPhone para Windows: música, volumen, batería y hora.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Opciones usadas al publicar el .exe único -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
